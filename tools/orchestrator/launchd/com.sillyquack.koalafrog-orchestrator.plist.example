<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.sillyquack.koalafrog-orchestrator</string>
  <key>ProgramArguments</key>
  <array>
    <string>/absolute/path/to/node</string>
    <string>/Users/owner/Library/Application Support/Koalafrog Orchestrator/runtime/releases/&lt;sha256&gt;/bin/repository-orchestrator.mjs</string>
    <string>watch</string>
    <string>--repository</string>
    <string>Sillyquack/koalafrog-hq</string>
    <string>--checkout</string>
    <string>/absolute/path/to/koalafrog-hq</string>
    <string>--codex-bin</string>
    <string>/Applications/ChatGPT.app/Contents/Resources/codex</string>
    <string>--state-dir</string>
    <string>/Users/owner/Library/Application Support/Koalafrog Orchestrator</string>
    <string>--poll-ms</string>
    <string>15000</string>
    <string>--base-ref</string>
    <string>origin/main</string>
    <string>--max-turns</string>
    <string>12</string>
    <string>--turn-timeout-ms</string>
    <string>1200000</string>
    <string>--max-retries</string>
    <string>2</string>
    <string>--retry-base-ms</string>
    <string>1000</string>
    <string>--discovery-limit</string>
    <string>50</string>
    <string>--max-tasks-per-poll</string>
    <string>4</string>
  </array>
  <key>WorkingDirectory</key>
  <string>/absolute/path/to/koalafrog-hq</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/usr/local/bin:/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
  </dict>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <dict>
    <key>SuccessfulExit</key>
    <false/>
  </dict>
  <key>ThrottleInterval</key>
  <integer>10</integer>
  <key>ProcessType</key>
  <string>Background</string>
  <key>StandardOutPath</key>
  <string>/Users/owner/Library/Application Support/Koalafrog Orchestrator/service/orchestrator.stdout.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/owner/Library/Application Support/Koalafrog Orchestrator/service/orchestrator.stderr.log</string>
</dict>
</plist>
